{% extends 'base.html.twig' %}

{% block title %}Les entrées — Privaris{% endblock %}
{% block meta_description %}Tous les labs, writeups, décryptages et veille du carnet Privaris.{% endblock %}
{% block body_class %}home{% endblock %}

{% block body %}
<nav>
  <div class="wrap">
    <a class="brand" href="{{ path('app_home') }}" aria-label="Privaris"><span class="dot" aria-hidden="true"></span> PRIVARIS</a>
    <div class="nav-right">
      <a class="back" href="{{ path('app_home') }}">← Accueil</a>
      <a class="nav-cta" href="{{ path('app_home') }}#contact">S'abonner</a>
    </div>
  </div>
</nav>

<section id="journal"><span id="contenu" tabindex="-1"></span>
  <div class="wrap">
    <div class="sec-head reveal">
      <div><div class="lbl">Entrées</div><h2 class="h2">Toutes les entrées.</h2></div>
      <p>Tout ce que je publie ici&nbsp;: labs, writeups, décryptages, veille. Filtre par type, ou parcours tout dans l'ordre.</p>
    </div>
    {% if entries|length >= 6 %}
    <div class="cats reveal" role="group" aria-label="Filtrer le carnet">
      <button class="cat on" data-k="all">Tout</button>
      <button class="cat" data-k="lab">Labs</button>
      <button class="cat" data-k="wri">Writeups</button>
      <button class="cat" data-k="dec">Décryptages</button>
      <button class="cat" data-k="vei">Veille</button>
    </div>
    {% endif %}
    <div class="ledger reveal" id="ledger">
      <div class="row"><span>Réf.</span><span>Type</span><span>Entrée</span><span style="text-align:right">Date</span></div>
      {% for entry in entries %}
      <div class="row" data-k="{{ entry.type.cssClass }}">
        <span class="id">{{ entry.reference }}</span>
        <span class="k {{ entry.type.cssClass }}">{{ entry.type.label }}</span>
        <span class="t">
          {% if entry.published %}<a href="{{ path('app_entry_show', {slug: entry.slug}) }}">{{ entry.title }}</a>{% else %}{{ entry.title }}{% endif %}
          <small>{{ entry.excerpt }}</small>
        </span>
        <span class="s">{{ entry.publishedAt ? entry.publishedAt|date('d/m/Y') : '—' }}</span>
      </div>
      {% else %}
      <div class="row"><span class="t">Le premier article arrive bientôt.</span></div>
      {% endfor %}
    </div>
  </div>
</section>

<div class="wrap"><footer><span>© {{ "now"|date("Y") }} Privaris · Besançon</span><span><a href="{{ path('app_legal_mentions') }}">Mentions légales</a> · <a href="{{ path('app_legal_privacy') }}">Confidentialité</a></span><span><a href="{{ path('app_rss') }}">Flux RSS</a></span></footer></div>
{% endblock %}
