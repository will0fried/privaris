<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Privaris — Sécurité offensive{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}Privaris — carnet de sécurité offensive. Je décortique comment on attaque un réseau et comment s'en protéger, expliqué en clair.{% endblock %}">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="alternate" type="application/rss+xml" title="Privaris — Carnet de sécurité offensive" href="{{ url('app_rss') }}">

    {# Aperçu lors du partage (LinkedIn, messageries, réseaux) — Open Graph + Twitter Card #}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Privaris">
    <meta property="og:title" content="{{ block('title') }}">
    <meta property="og:description" content="{{ block('meta_description') }}">
    <meta property="og:image" content="{{ absolute_url('/og.png') }}">
    <meta property="og:url" content="{{ app.request.uri }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ block('title') }}">
    <meta name="twitter:description" content="{{ block('meta_description') }}">
    <meta name="twitter:image" content="{{ absolute_url('/og.png') }}">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% block stylesheets %}{% endblock %}
    {{ importmap('app') }}
</head>
<body>
{% block body %}{% endblock %}
{% block javascripts %}{% endblock %}
</body>
</html>
